<% legend = "Select a team" %>

<% content_for :page_title, legend %>

<%= form_with url: users_teams_path, method: :post do |f| %>
  <%= f.govuk_collection_radio_buttons :team_id,
                                       @teams,
                                       :id,
                                       :name,
                                       -> { _1.organisation.ods_code },
                                       legend: { text: legend, size: "xl", tag: "h1" } %>

  <%= f.govuk_submit %>
<% end %>
